{
  "info": {
    "name": "PacketGuard AI - CRUD & API Tests",
    "description": "Postman collection. The README documents GET|PATCH /api/blockrules; POST and DELETE block-rule requests are conventional candidates and may need backend verification. Alerts requests reflect documented endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ruleId",
      "value": ""
    },
    {
      "key": "alertId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Analyst demo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"analyst@packetguard.local\",\n  \"password\": \"Analyst123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Block Rules - CRUD (verify endpoints)",
      "item": [
        {
          "name": "READ - List rules",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blockrules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blockrules"
              ]
            }
          }
        },
        {
          "name": "CREATE - Candidate POST",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ip\": \"192.0.2.10\",\n  \"reason\": \"Postman CRUD test\",\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/blockrules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blockrules"
              ]
            }
          }
        },
        {
          "name": "UPDATE - Candidate PATCH",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false,\n  \"reason\": \"Updated from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/blockrules/{{ruleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blockrules",
                "{{ruleId}}"
              ]
            }
          }
        },
        {
          "name": "DELETE - Candidate",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blockrules/{{ruleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blockrules",
                "{{ruleId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Alerts - Read & lifecycle",
      "item": [
        {
          "name": "READ - List alerts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "alerts"
              ]
            }
          }
        },
        {
          "name": "READ - Alert detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/alerts/{{alertId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "alerts",
                "{{alertId}}"
              ]
            }
          }
        },
        {
          "name": "UPDATE - Alert status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Acknowledged\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/alerts/{{alertId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "alerts",
                "{{alertId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Action - Block alert (acknowledged only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/alerts/{{alertId}}/block",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "alerts",
                "{{alertId}}",
                "block"
              ]
            }
          }
        },
        {
          "name": "READ - Export CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/alerts/export",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "alerts",
                "export"
              ]
            }
          }
        }
      ]
    }
  ]
}