// Docker-only pipeline for Jenkins on Windows (uses bat, not sh).
// Plugins: Email Extension, JUnit.
pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  parameters {
    string(name: 'REGISTRY', defaultValue: 'docker.io/anjali120805', description: 'Container registry namespace')
    booleanParam(name: 'RUN_SCAN', defaultValue: false, description: 'Run the Trivy vulnerability scan (downloads a large database)')
    booleanParam(name: 'PUSH', defaultValue: false, description: 'Push images to the registry (needs registry-creds)')
  }
  environment {
    TAG = "${env.BUILD_NUMBER}"
    SERVICES = 'backend frontend ml-service sniffer'
    TEAM_EMAILS = 'shahvinisha27@gmail.com,ayushinawal05@gmail.com,shraddhamandal04@gmail.com'
  }
  stages {
    stage('Checkout') { steps { checkout scm } }

    stage('Check Docker') {
      steps { bat 'docker version' }
    }

    stage('Lint & Unit Tests') {
      parallel {
        stage('Backend') {
          steps {
            bat 'docker run --rm -v npm-cache:/root/.npm -v "%WORKSPACE%\\backend:/app" -w /app node:24-slim sh -c "npm install --no-audit --no-fund --no-package-lock && node --check src/index.js && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml test/*.test.js"'
          }
        }
        stage('Frontend build') {
          steps {
            bat 'docker run --rm -v npm-cache:/root/.npm -v "%WORKSPACE%\\frontend:/app" -w /app node:24-slim sh -c "npm install --no-audit --no-fund --no-package-lock && npm run build"'
          }
        }
        stage('Python (ML + sniffer)') {
          steps {
            bat 'docker run --rm -v pip-cache:/root/.cache/pip -v "%WORKSPACE%:/repo" -w /repo python:3.12-slim sh -c "apt-get update -qq && apt-get install -y -qq libgomp1 >/dev/null && pip install -q -r ml-service/requirements.txt flake8 && flake8 --select=E9,F63,F7,F82 shared sniffer ml-service && pytest -q tests --junitxml=pytest-results.xml"'
          }
        }
      }
    }

    stage('Build Docker Images') {
      steps {
        bat 'docker build -t %REGISTRY%/packetguard-backend:%TAG% .\\backend || exit /b 1'
        bat 'docker build -t %REGISTRY%/packetguard-frontend:%TAG% .\\frontend || exit /b 1'
        bat 'docker build -t %REGISTRY%/packetguard-ml-service:%TAG% -f ml-service\\Dockerfile . || exit /b 1'
        bat 'docker build -t %REGISTRY%/packetguard-sniffer:%TAG% -f sniffer\\Dockerfile . || exit /b 1'
      }
    }

    stage('UI Tests (Selenium)') {
      steps {
        bat 'docker compose -p pgci -f docker-compose.yml -f docker-compose.ci.yml up -d --build --wait --wait-timeout 600'
        bat 'docker build -t pg-selenium -f selenium-tests\\Dockerfile selenium-tests'
        bat(returnStatus: true, script: 'docker rm -f pg-selenium-run')
        script {
          def rc = bat(returnStatus: true, script: 'docker run --name pg-selenium-run --network pgci_default -e BASE_URL=http://frontend pg-selenium')
          bat(returnStatus: true, script: 'if exist selenium-out rmdir /s /q selenium-out')
          bat(returnStatus: true, script: 'mkdir selenium-out')
          bat(returnStatus: true, script: 'docker cp pg-selenium-run:/tests/results selenium-out\\results')
          bat(returnStatus: true, script: 'docker cp pg-selenium-run:/tests/screenshots selenium-out\\screenshots')
          bat(returnStatus: true, script: 'docker rm -f pg-selenium-run')
          if (rc != 0) { error("Selenium UI tests failed (exit code ${rc})") }
        }
      }
    }

    stage('Security & Dependency Scan') {
      when { expression { params.RUN_SCAN } }
      steps {
        script {
          for (s in env.SERVICES.split(' ')) {
            bat "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image --severity CRITICAL --exit-code 0 --no-progress ${params.REGISTRY}/packetguard-${s}:${env.TAG}"
          }
        }
      }
    }

    stage('Push to Registry') {
      when { expression { params.PUSH } }
      steps {
        withCredentials([usernamePassword(credentialsId: 'registry-creds', usernameVariable: 'U', passwordVariable: 'P')]) {
          bat 'echo %P%| docker login -u %U% --password-stdin || exit /b 1'
          bat 'for %%s in (%SERVICES%) do docker push %REGISTRY%/packetguard-%%s:%TAG% || exit /b 1'
        }
      }
    }
  }

  post {
    always {
      junit allowEmptyResults: true, testResults: 'backend/test-results.xml, pytest-results.xml, selenium-out/results/selenium-results.xml'
      archiveArtifacts artifacts: 'selenium-out/screenshots/**', allowEmptyArchive: true
      bat(returnStatus: true, script: 'docker compose -p pgci -f docker-compose.yml -f docker-compose.ci.yml down -v')
      bat(returnStatus: true, script: 'docker image prune -f')
    }
    success { echo "Build ${env.BUILD_NUMBER} succeeded." }
    failure {
      emailext(
        to: "${env.TEAM_EMAILS}",
        subject: "FAILED: PacketGuard build #${env.BUILD_NUMBER}",
        mimeType: 'text/html',
        attachLog: true,
        compressLog: true,
        attachmentsPattern: 'selenium-out/screenshots/*.png',
        body: """
          <h3>PacketGuard AI: build #${env.BUILD_NUMBER} FAILED</h3>
          <p><b>Job:</b> ${env.JOB_NAME}</p>
          <p><b>Tests:</b> \${TEST_COUNTS}</p>
          <p><b>Failed tests:</b><br><pre>\${FAILED_TESTS}</pre></p>
          <p><a href="${env.BUILD_URL}console">Open console log</a> |
             <a href="${env.BUILD_URL}testReport">Open test report</a></p>
          <p>The build log is attached. Selenium failure screenshots are attached if a UI test failed.</p>
        """
      )
    }
    fixed {
      emailext(
        to: "${env.TEAM_EMAILS}",
        subject: "FIXED: PacketGuard build #${env.BUILD_NUMBER} is passing again",
        mimeType: 'text/html',
        body: "<p>Build #${env.BUILD_NUMBER} passed. <a href='${env.BUILD_URL}'>Open build</a></p>"
      )
    }
  }
}