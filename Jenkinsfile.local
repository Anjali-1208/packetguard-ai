// Docker-only pipeline: tests -> build images -> scan -> (optional) push.
// Plugins: Email Extension, JUnit.
pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  parameters {
    string(name: 'REGISTRY', defaultValue: 'docker.io/anjali120805', description: 'Container registry namespace')
    booleanParam(name: 'PUSH', defaultValue: false, description: 'Push images to the registry (needs registry-creds)')
    booleanParam(name: 'FAIL_ON_CRITICAL_CVE', defaultValue: false, description: 'Fail the build if Trivy finds CRITICAL vulnerabilities')
  }
  environment {
    TAG = "${env.BUILD_NUMBER}"
    SERVICES = 'backend frontend ml-service sniffer'
    TEAM_EMAILS = 'anjali200512@gmail.com,shahvinisha27@gmail.com,ayushinawal05@gmail.com,shraddhamandal04@gmail.com'
  }
  stages {
    stage('Checkout') { steps { checkout scm } }

    stage('Lint & Unit Tests') {
      parallel {
        stage('Backend') {
          steps {
            sh '''docker run --rm -v "$PWD/backend:/app" -w /app node:24-slim sh -c "npm install --no-audit --no-fund && node --check src/index.js && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml test/"'''
          }
        }
        stage('Frontend build') {
          steps { sh '''docker run --rm -v "$PWD/frontend:/app" -w /app node:24-slim sh -c "npm install --no-audit --no-fund && npm run build"''' }
        }
        stage('Python (ML + sniffer)') {
          steps {
            sh '''docker run --rm -v "$PWD:/repo" -w /repo python:3.12-slim sh -c "apt-get update -qq && apt-get install -y -qq libgomp1 >/dev/null && pip install -q -r ml-service/requirements.txt flake8 && flake8 --select=E9,F63,F7,F82 shared sniffer ml-service && pytest -q tests --junitxml=pytest-results.xml"'''
          }
        }
      }
    }

    stage('Build Docker Images') {
      steps {
        sh '''
          docker build -t $REGISTRY/packetguard-backend:$TAG   ./backend
          docker build -t $REGISTRY/packetguard-frontend:$TAG  ./frontend
          docker build -t $REGISTRY/packetguard-ml-service:$TAG -f ml-service/Dockerfile .
          docker build -t $REGISTRY/packetguard-sniffer:$TAG   -f sniffer/Dockerfile .
        '''
      }
    }

    stage('Security & Dependency Scan') {
      steps {
        script {
          def code = params.FAIL_ON_CRITICAL_CVE ? 1 : 0
          for (s in env.SERVICES.split(' ')) {
            sh "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image --severity CRITICAL --exit-code ${code} --no-progress ${params.REGISTRY}/packetguard-${s}:${env.TAG}"
          }
        }
      }
    }

    stage('Push to Registry') {
      when { expression { params.PUSH } }
      steps {
        withCredentials([usernamePassword(credentialsId: 'registry-creds', usernameVariable: 'U', passwordVariable: 'P')]) {
          sh '''
            echo "$P" | docker login -u "$U" --password-stdin
            for s in $SERVICES; do docker push $REGISTRY/packetguard-$s:$TAG; done
          '''
        }
      }
    }
  }

  post {
    always {
      junit allowEmptyResults: true, testResults: 'backend/test-results.xml, pytest-results.xml'
      sh 'docker image prune -f || true'
    }
    success { echo "Build ${env.BUILD_NUMBER} succeeded." }
    failure {
      emailext(
        to: "${env.TEAM_EMAILS}",
        subject: "FAILED: PacketGuard build #${env.BUILD_NUMBER}",
        mimeType: 'text/html',
        attachLog: true,
        compressLog: true,
        body: """
          <h3>PacketGuard AI: build #${env.BUILD_NUMBER} FAILED</h3>
          <p><b>Job:</b> ${env.JOB_NAME}</p>
          <p><b>Tests:</b> \${TEST_COUNTS}</p>
          <p><b>Failed tests:</b><br><pre>\${FAILED_TESTS}</pre></p>
          <p><a href="${env.BUILD_URL}console">Open console log</a> |
             <a href="${env.BUILD_URL}testReport">Open test report</a></p>
          <p>The build log is attached.</p>
        """
      )
    }
    fixed {
      emailext(
        to: "${env.TEAM_EMAILS}",
        subject: "FIXED: PacketGuard build #${env.BUILD_NUMBER} is passing again",
        mimeType: 'text/html',
        body: "<p>Build #${env.BUILD_NUMBER} passed. <a href='${env.BUILD_URL}'>Open build</a></p>"
      )
    }
  }
}