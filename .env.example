# copy to .env (docker compose reads it automatically)
JWT_SECRET=please-change-me-to-a-long-random-string
SNIFFER_MODE=simulate          # simulate | pcap | live
FLOWS_PER_MINUTE=100
ATTACK_RATIO=0.30
SEED_DEMO_USERS=true

# optional integrations
ABUSEIPDB_API_KEY=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# train on real CIC-IDS2017: put the CSV in ./data and set (path is relative to the ml-service image)
# DATASET_CSV=data/cicids2017.csv
